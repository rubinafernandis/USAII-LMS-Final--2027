# USAII Intuitive LMS 5.13.1 settings. Copy to .env for local use; on a host, enter these in its
# "Environment" settings. Lines starting with # are off.

# ---- Where data lives (production needs ONE of these, or it refuses to start) ----
# PostgreSQL (recommended on every host). Use the DIRECT connection string, not a pooled one.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DATABASE_SSL=true            # default: TLS for remote databases, off for localhost; "strict" verifies certificates
# Or a folder on a persistent disk (VPS or mounted volume). Uploads go to DATA_DIR/uploads.
# DATA_DIR=/var/lib/usaii-lms/data
# UPLOAD_DIR=                  # optional: keep uploads elsewhere (with DATABASE_URL, set it only if you have a persistent disk)

# ---- Owner (admin) account, used only when the database is first created ----
# SEED_ADMIN_EMAIL=you@yourdomain.com
# SEED_ADMIN_NAME=USAII Admin
# SEED_ADMIN_PASSWORD=          # 12+ chars, upper and lower case, a number and a symbol. Without it a one-time password is printed in the log.

# ---- Site ----
PORT=4600
# PUBLIC_URL=https://learn.yourdomain.com      # the exact LMS address: password-reset links and the return from payment pages use it
# SUPPORT_EMAIL=support@yourdomain.com          # shown to learners on Help & Support and in account messages (and in the suspension email)
# TERMS_URL=https://www.usaii.org/terms-of-use  # linked from the suspension email
# TERMS_EMAIL=termsofuse@usaii.org              # Terms of Use contact named in the suspension email
# ALLOW_SIGNUP=true                             # the sign-up form (course, details, payment); "false" turns it off
# TRUST_PROXY=1                                 # behind a host's proxy or load balancer
# AUTH_SECRET=                                  # optional: 32+ random characters. Without it one is generated and kept with the data.

# ---- Automatic evaluation, rubric import from PDF, transcripts (one key is enough) ----
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# AI_MODEL=                     # optional model override
# AUTO_EVALUATION=on            # "off" sends every rubric submission to the admin instead

# ---- Email: the SENDER of password reset codes and links (valid 24 hours), receipts, decisions on work ----
# Any SMTP mailbox. Port 465 = SSL, 587 = STARTTLS. Restart the LMS after changing these, then use
# Payments & Email -> "Send test email". Without them, "Forgot password?" says to try again later.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=no-reply@yourdomain.com
# SMTP_PASS=
# MAIL_FROM=USAII <no-reply@yourdomain.com>
# MAIL_OUTBOX=1                 # local testing only: write emails to a folder instead of sending

# ---- Payments (keys here, or in the admin portal: Payments & Email) ----
# One or more gateways. With more than one, learners choose on the sign-up form. The money is paid out to
# the bank account registered in each gateway's dashboard (the LMS never stores bank details).
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=sk_live_xxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# PAYPAL_MODE=live
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYMENT_PROVIDER=             # razorpay | stripe | paypal, when more than one is set
# PAYMENT_CURRENCY=USD
# MAX_COURSE_PRICE=              # highest course price allowed (USD default: less than 150)

# ---- Optional media services ----
# VIMEO_ACCESS_TOKEN=
# GOOGLE_TRANSLATE_API_KEY=      # optional: transcripts translate without any key; a key gives a guaranteed service
# FREE_TRANSLATION=off           # optional: turn off the key free transcript translation

# ---- Public website (AI Micro Credentials landing page, Explore Courses, course pages) ----
# SITE_URL=https://www.usaii.org/ai-micro-credentials   # linked from the sign in page ("Explore AI Micro Credentials")
# SITE_ORIGINS=https://www.usaii.org,https://usaii.org  # sites allowed to read the catalog and send enquiries (unset = any)
# ENQUIRY_EMAIL=admissions@usaii.org                    # where "Get More Details" requests are emailed (default SUPPORT_EMAIL)
# SEED_COURSE_PRICE=74           # NEW databases only: the 8 USAII courses start published at this current price; "none" = drafts
# SEED_LIST_PRICE=147            # NEW databases (and the 5.14 upgrade): selling price shown struck out on the website; "none" = no struck price
